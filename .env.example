# Conexão com o PostgreSQL (Supabase ou Postgres local).
#
# Supabase (produção / Vercel): use a string do "Transaction pooler" (porta 6543)
# em Project Settings > Database > Connection string. Exemplo:
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# Desenvolvimento local (Postgres via Docker/apt ou `supabase start`, porta 54322):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Opcional: usado só pelos scripts de migração (psql) quando a URL do pooler
# não aceita DDL. Se vazio, os scripts usam DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres

# Token do servidor MCP do bot (/api/mcp). Gere com `openssl rand -hex 32` e
# configure o mesmo valor no cliente (Cursor/Grok) como "Authorization: Bearer <token>".
# Sem a variável a rota fica desligada (503).
# MCP_TOKEN=

# Banco descartável usado só pelos testes de integração (npm test). Os testes
# apagam e recarregam tudo nele — nunca aponte para o banco real.
# DATABASE_URL_TESTE=postgresql://app:app@127.0.0.1:5432/comissoes_teste

# Chaves do Supabase (reservadas para Auth/Storage nas fases seguintes; o MVP
# acessa o banco direto via DATABASE_URL e não expõe nada ao navegador).
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
